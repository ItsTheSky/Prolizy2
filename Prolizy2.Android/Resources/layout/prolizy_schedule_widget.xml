<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@drawable/widget_background"
              android:padding="8dp">

    <!-- Header -->
    <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prochain Cours"
            android:textSize="18sp"
            android:textColor="@color/white_text"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

    <!-- Main Course Info -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

        <!-- Domain/Subject -->
        <TextView
                android:id="@+id/widget_domain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📚 Domaine"
                android:textSize="14sp"
                android:textColor="@color/white_text"
                android:textStyle="bold"
                android:background="@drawable/domain_background"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginEnd="8dp"/>

        <!-- Time -->
        <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ 09:30 - 10:45"
                android:textSize="14sp"
                android:textColor="@color/white_text"
                android:textStyle="bold"
                android:background="@drawable/time_background"
                android:padding="8dp"
                android:gravity="center"
                android:minWidth="140dp"/>

    </LinearLayout>

    <!-- Course Title -->
    <TextView
            android:id="@+id/widget_course_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R2.09 - Méthodes numériques"
            android:textSize="16sp"
            android:textColor="@color/white_text"
            android:textStyle="bold"
            android:gravity="left"
            android:layout_marginBottom="8dp"/>

    <!-- Bottom Info -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <!-- Room -->
        <TextView
                android:id="@+id/widget_room"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏫 314 - VEL"
                android:textSize="12sp"
                android:textColor="@color/white_text"
                android:textStyle="bold"
                android:background="@drawable/room_background"
                android:padding="6dp"
                android:gravity="center"
                android:layout_marginEnd="8dp"/>

        <!-- Professor -->
        <TextView
                android:id="@+id/widget_professor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👨‍🏫 OSTER Alain"
                android:textSize="12sp"
                android:textColor="@color/white_text"
                android:textStyle="bold"
                android:background="@drawable/professor_background"
                android:padding="6dp"
                android:gravity="center"/>

    </LinearLayout>

    <!-- Additional Info -->
    <TextView
            android:id="@+id/widget_additional_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cliquez pour plus d'informations"
            android:textSize="10sp"
            android:textColor="@color/light_gray_text"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="visible"/>

</LinearLayout>
