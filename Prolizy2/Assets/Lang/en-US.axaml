    <system:String x:Key="HomeCardDecisionDeferred">Deferred</system:String>
    <system:String x:Key="HomeCardDecisionFailed">Not admitted</system:String>

    <system:String x:Key="HomeCardTypeNextCourse">Next class</system:String>
    <system:String x:Key="HomeCardTypeOverview">Bulletin average</system:String>
    <system:String x:Key="HomeCardTypeEvaluation">Grades of a resource / SAÉ</system:String>
    <system:String x:Key="HomeCardTypeUnits">Teaching units</system:String>

    <system:String x:Key="HomeSettingsEdit">Customise home</system:String>
    <system:String x:Key="HomeSettingsAddCard">Add a card</system:String>
    <system:String x:Key="HomeSettingsCardsTitle">Home cards</system:String>
    <system:String x:Key="HomeSettingsCardsDesc">Add, reorder and configure the cards displayed on your home page.</system:String>
    <system:String x:Key="HomeSettingsSave">Save</system:String>
    <system:String x:Key="HomeSettingsReset">Reset</system:String>
    <system:String x:Key="HomeSettingsNoCards">No card yet.</system:String>
    <system:String x:Key="HomeSettingsHalf">1 slot</system:String>
    <system:String x:Key="HomeSettingsFull">2 slots</system:String>
    <system:String x:Key="HomeSettingsVariantClassic">Classic</system:String>
    <system:String x:Key="HomeSettingsVariantCompact">Compact</system:String>
    <system:String x:Key="HomeSettingsMaxItems">Rows</system:String>
    <system:String x:Key="HomeSettingsMoveUp">Move up</system:String>
    <system:String x:Key="HomeSettingsMoveDown">Move down</system:String>
    <system:String x:Key="HomeSettingsRemoveCard">Remove</system:String>
    <system:String x:Key="HomeSettingsSemesterCurrent">Current semester</system:String>
    <system:String x:Key="HomeSettingsDiscardTitle">Unsaved changes</system:String>
    <system:String x:Key="HomeSettingsDiscardMessage">Your changes are not saved yet. Do you want to discard them?</system:String>
    <system:String x:Key="HomeSettingsDiscardKeepEditing">Keep editing</system:String>
    <system:String x:Key="HomeSettingsDiscardLeave">Discard</system:String>

</ResourceDictionary>
