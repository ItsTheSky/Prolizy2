<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Prolizy2.Styles.Controls.Bulletin"
        xmlns:bvm="using:Prolizy2.ViewModels.Bulletin"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia">
    <Design.PreviewWith>
        <Border Width="380" Padding="15" Background="#0E0E10">
            <controls:EvaluationGroupCard />
        </Border>
    </Design.PreviewWith>

    <Style Selector="controls|EvaluationGroupCard">
        <Setter Property="Template">
            <ControlTemplate>
                <suki:GlassCard x:CompileBindings="False"
                                Padding="0"
                                CornerRadius="8"
                                DataContext="{TemplateBinding Group}">
                    <StackPanel>

                        <Button x:Name="PART_Header"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="0">
                            <Border x:Name="PART_Body" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                    <Border Grid.Column="0"
                                            Background="{Binding AccentSoftBrush}"
                                            CornerRadius="6"
                                            MinWidth="52"
                                            Padding="6,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Code}"
                                                   FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Foreground="{Binding AccentBrush}" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Margin="8,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <controls:GradeText Grid.Column="2"
                                                        Grade="{Binding Average}"
                                                        GradeSize="18"
                                                        ShowMaximum="False"
                                                        VerticalAlignment="Center" />

                                    <Panel Grid.Column="3" Width="20"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center">
                                        <iconPacks:PackIconLucide Kind="ChevronDown"
                                                                  Width="16" Height="16"
                                                                  Foreground="{DynamicResource SukiLowText}"
                                                                  IsVisible="{Binding !IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <iconPacks:PackIconLucide Kind="ChevronUp"
                                                                  Width="16" Height="16"
                                                                  Foreground="{DynamicResource SukiLowText}"
                                                                  IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Panel>

                                </Grid>
                            </Border>
                        </Button>

                        <Border x:Name="PART_Expanded"
                                IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource SukiBorderBrush}"
                                Padding="12,8,12,10">
                            <Panel>
                                <TextBlock Text="Aucune évaluation"
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource SukiLowText}"
                                           IsVisible="{Binding !HasEvaluations}" />

                                <ItemsControl ItemsSource="{Binding Evaluations}"
                                              IsVisible="{Binding HasEvaluations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <controls:GradeText Grid.Column="1"
                                                                    Grade="{Binding Grade}"
                                                                    GradeSize="13"
                                                                    ShowMaximum="False"
                                                                    Margin="10,0,0,0"
                                                                    Foreground="{Binding Grade.ToneBrush}"
                                                                    DimBrush="{Binding Grade.ToneBrush}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CoefficientLabel}"
                                                           FontSize="10"
                                                           MinWidth="34"
                                                           Margin="10,0,0,0"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SukiLowText}"
                                                           IsVisible="{Binding ShowCoefficients, Source={x:Static bvm:BulletinDisplayOptions.Instance}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                        </Border>

                    </StackPanel>
                </suki:GlassCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EvaluationGroupCard:dense /template/ Border#PART_Body">
        <Setter Property="Padding" Value="12,7" />
    </Style>
</Styles>
