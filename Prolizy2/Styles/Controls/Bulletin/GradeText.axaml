<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Prolizy2.Styles.Controls.Bulletin">
    <Design.PreviewWith>
        <StackPanel Margin="20" Spacing="10" Background="#0E0E10">
            <controls:GradeText GradeSize="40" />
            <controls:GradeText GradeSize="22" ShowMaximum="False" />
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|GradeText">
        <Setter Property="DimBrush" Value="{DynamicResource SukiLowText}" />
        <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel x:CompileBindings="False"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            DataContext="{TemplateBinding Grade}">

                    <TextBlock Text="{Binding IntegerPart}"
                               FontSize="{TemplateBinding GradeSize}"
                               FontWeight="Bold"
                               VerticalAlignment="Bottom"
                               Foreground="{TemplateBinding Foreground}" />

                    <TextBlock Text="{Binding DecimalPart}"
                               IsVisible="{Binding IsNumeric}"
                               FontSize="{Binding DecimalFontSize, RelativeSource={RelativeSource TemplatedParent}}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Bottom"
                               Foreground="{TemplateBinding DimBrush}" />

                    <TextBlock Text="{Binding MaximumLabel}"
                               IsVisible="{Binding ShowsMaximum, RelativeSource={RelativeSource TemplatedParent}}"
                               FontSize="{Binding MaximumFontSize, RelativeSource={RelativeSource TemplatedParent}}"
                               FontWeight="Medium"
                               Margin="2,0,0,0"
                               VerticalAlignment="Bottom"
                               Foreground="{TemplateBinding DimBrush}" />

                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
