<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Prolizy2.Styles.Controls.Bulletin">
    <Design.PreviewWith>
        <Border Width="380" Padding="15" Background="#0E0E10">
            <controls:BulletinHeaderBar />
        </Border>
    </Design.PreviewWith>

    <Style Selector="controls|BulletinHeaderBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,8">

                    <TextBlock Grid.Column="0"
                               Text="{TemplateBinding Title}"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SukiText}" />

                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="36" Height="36"
                            Padding="0"
                            CornerRadius="18"
                            VerticalAlignment="Center"
                            Command="{TemplateBinding RefreshCommand}">
                        <LucideIcon Kind="Download" Size="20" />
                    </Button>

                    <Button Grid.Column="2"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="36" Height="36"
                            Padding="0"
                            CornerRadius="18"
                            VerticalAlignment="Center"
                            Command="{TemplateBinding StudentCommand}">
                        <LucideIcon Kind="CircleUser" Size="22" />
                    </Button>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
