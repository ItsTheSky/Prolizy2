<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Prolizy2.Styles.Controls.Edt">
    <Design.PreviewWith>
        <controls:DailyScheduleControl />
    </Design.PreviewWith>

    <Style Selector="controls|DailyScheduleControl">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="PART_MainGrid" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*">

                    <!-- Time Labels Container - Using Canvas for precise positioning -->
                    <Canvas Grid.Column="0" 
                            Grid.Row="0"
                            Name="PART_TimeLabelsContainer"
                            Width="30"
                            Background="Transparent">
                        <!-- Time labels will be generated dynamically and positioned with Canvas.Top -->
                    </Canvas>

                    <!-- Extra space for the last hour label -->
                    <Border Grid.Column="0" 
                            Grid.Row="1" 
                            Height="15" 
                            Background="Transparent"/>

                    <!-- Schedule Canvas -->
                    <Canvas Grid.Column="1" 
                            Grid.Row="0"
                            Name="PART_ScheduleCanvas"
                            Background="Transparent"
                            ClipToBounds="True"/>

                    <!-- No Data Message -->
                    <TextBlock Grid.Column="1"
                               Grid.Row="0"
                               Name="PART_NoDataText"
                               Text="Aucun cours"
                               Foreground="Gray"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               IsVisible="False"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
