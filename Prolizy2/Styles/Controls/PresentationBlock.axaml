<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Prolizy2.Styles.Controls">
    <Design.PreviewWith>
        <controls:PresentationBlock
            ButtonText="Refresh"
            ButtonIcon="ArchiveRestore"

            Icon="TriangleAlert"
            Title="Server Offline"
            Description="Please review your connection details and server's state." />
    </Design.PreviewWith>

    <Style Selector="controls|PresentationBlock">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <LucideIcon Kind="{TemplateBinding Icon}"
                                Size="48"
                                HorizontalAlignment="Center" />

                    <TextBlock Text="{TemplateBinding Title}"
                               FontWeight="SemiBold"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <TextBlock Text="{TemplateBinding Description}"
                               IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontWeight="SemiLight"
                               FontSize="16"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <ContentPresenter Content="{TemplateBinding Content}"
                                      IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                    <Button IsVisible="{TemplateBinding ButtonText, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{TemplateBinding ButtonCommand}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{TemplateBinding ButtonText}"
                                       IsVisible="{TemplateBinding ButtonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            
                            <LucideIcon Kind="{TemplateBinding ButtonIcon}"
                                        IsVisible="{TemplateBinding ButtonIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>