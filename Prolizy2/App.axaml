<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prolizy2.App"
             xmlns:sukiUi="clr-namespace:SukiUI;assembly=SukiUI"
             xmlns:common="clr-namespace:Prolizy2.ViewModels.Common"
             xmlns:utilities="clr-namespace:Prolizy2.Utilities"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <utilities:ViewLocator />
    </Application.DataTemplates>
    
    <Application.Styles>
        <sukiUi:SukiTheme ThemeColor="Orange" Locale="en-US" />
        
        <StyleInclude Source="avares://IconPacks.Avalonia/Icons.axaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
        
        <StyleInclude Source="avares://Prolizy2/Styles/Overrides/FixedDialogs.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Overrides/Typography.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Overrides/ColoredCards.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Overrides/Settings.axaml" />
        
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/ModuleCard.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Badge.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/PresentationBlock.axaml" />
        
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Edt/ScheduleItemCard.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Edt/DailyScheduleControl.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Edt/ItemDialogOverlay.axaml" />
        
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Settings/SettingsMenuItem.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Settings/SettingSubPage.axaml" />

        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Bulletin/GradeText.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Bulletin/SectionHeader.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Bulletin/BulletinHeaderBar.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Bulletin/DetailHeaderBar.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Bulletin/SemesterHeroCard.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Bulletin/UnitCard.axaml" />
        <StyleInclude Source="avares://Prolizy2/Styles/Controls/Bulletin/EvaluationGroupCard.axaml" />
    </Application.Styles>
    
    <Application.Resources>
        
        <system:Boolean x:Key="ProlizyHasItemCardData">True</system:Boolean>
        
        <Color x:Key="ProSuccessColor">#4CAF50</Color>
        <Color x:Key="ProSuccessColorLight">#A5D6A7</Color>
        <Color x:Key="ProSuccessColorDark">#388E3C</Color>
        <Color x:Key="ProSuccessColorText">#FFFFFF</Color>
    
        <!-- Info Colors -->
        <Color x:Key="ProInfoColor">#2196F3</Color>
        <Color x:Key="ProInfoColorLight">#BBDEFB</Color>
        <Color x:Key="ProInfoColorDark">#1976D2</Color>
        <Color x:Key="ProInfoColorText">#FFFFFF</Color>
    
        <!-- Warning Colors -->
        <Color x:Key="ProWarningColor">#FF9800</Color>
        <Color x:Key="ProWarningColorLight">#FFB74D</Color>
        <Color x:Key="ProWarningColorDark">#F57C00</Color>
        <Color x:Key="ProWarningColorText">#FFFFFF</Color>
    
        <!-- Error Colors -->
        <Color x:Key="ProErrorColor">#F44336</Color>
        <Color x:Key="ProErrorColorLight">#EF9A9A</Color>
        <Color x:Key="ProErrorColorDark">#D32F2F</Color>
        <Color x:Key="ProErrorColorText">#FFFFFF</Color>
    
        <!-- Neutral Colors -->
        <Color x:Key="ProNeutralColor">#9E9E9E</Color>
        <Color x:Key="ProNeutralColorLight">#E0E0E0</Color>
        <Color x:Key="ProNeutralColorDark">#616161</Color>
        <Color x:Key="ProNeutralColorText">#000000</Color>
        
        <!-- Converters -->
        <common:LangKeyToValueConverter x:Key="LangKeyToValueConverter" />
    </Application.Resources>
    
</Application>