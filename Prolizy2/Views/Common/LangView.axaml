<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Prolizy2.ViewModels.Common"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="common:LangViewModel"
             x:Class="Prolizy2.Views.Common.LangView">
    
    <ListBox ItemsSource="{Binding Langs}" HorizontalAlignment="Stretch"
             SelectedValue="{Binding SelectedValue}">
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="common:LangEntry">
                
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch">
                    
                    <Border CornerRadius="10" ClipToBounds="True">
                        <Image Source="{Binding Icon}"
                               Height="22"/>
                    </Border>
                    
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                    
                </StackPanel>
                
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
    
</UserControl>