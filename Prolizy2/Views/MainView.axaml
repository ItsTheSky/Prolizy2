                                                                  Margin="10"
                                                                  HorizontalAlignment="Center"
                                                                  Foreground="{DynamicResource SukiPrimaryColor}"
                                                                  Kind="LogIn" />
                                        <TextBlock Margin="0,5,0,27"
                                                   HorizontalAlignment="Center"
                                                   FontSize="18"
                                                   FontWeight="DemiBold"
                                                   Text="Sign-in to your account" />
