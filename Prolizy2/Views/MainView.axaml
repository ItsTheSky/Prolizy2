                                <iconPacks:PackIconLucide Kind="Angry" />
                                <TextBlock Text="Angry" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Orientation="Vertical" Spacing="5">
                            
                            <controls:ModuleCard Title="Prochains Cours" VerticalAlignment="Top"
                                                 Icon="CalendarDays">
                            </controls:ModuleCard>
                            <controls:ModuleCard Title="Dernières Notes" VerticalAlignment="Top"
                                                 Icon="NotebookPen">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5"
                                                     ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SAÉ statistique BD"/>
                                    <controls:Badge HorizontalAlignment="Right" Grid.Row="0" Grid.Column="1" Text="18/20"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="C2"/>
                                    <controls:Badge HorizontalAlignment="Right" Grid.Row="1" Grid.Column="1" Text="12/20"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="DS1 Compta-finance"/>
                                    <controls:Badge HorizontalAlignment="Right" Grid.Row="2" Grid.Column="1" Text="ATT"/>
                                </Grid>
                            </controls:ModuleCard>
                        
                            <controls:ModuleCard Title="Absences" VerticalAlignment="Top"
                                                 Icon="CalendarOff">
                                <TextBlock Text="I'm inside :o" />
                            </controls:ModuleCard>
                        
                            <controls:ModuleCard Title="Test" VerticalAlignment="Top"
                                                 Icon="Clock7">
                                <TextBlock Text="I'm inside :o" />
                            </controls:ModuleCard>
                        </StackPanel>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Classes="TabItemPanel">
                                <iconPacks:PackIconLucide Kind="Radius" />
                                <TextBlock Text="Idk" />
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>
                </TabControl>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding Vector}" Foreground="Beige" />
            </Grid>
             -->

            <Grid RowDefinitions="*,Auto" RowSpacing="10"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <ContentControl Grid.Row="0" Margin="15"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Content="{Binding DisplayedControl}" />

                <suki:GlassCard Grid.Row="1" CornerRadius="0">

                    <ItemsControl ItemsSource="{Binding TabEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding TabEntries.Count}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TabItemEntry">
                                <Button Padding="0" HorizontalAlignment="Stretch" BorderThickness="0"
                                        Command="{Binding ClickedCommand}">

                                    <StackPanel Classes.IsTabItemSelected="{Binding IsSelected}"
                                                Spacing="5">

                                        <iconPacks:PackIconLucide Kind="{Binding Icon}"
                                                                  HorizontalAlignment="Center"
                                                                  Width="24" Height="24" />
                                        <TextBlock FontSize="16"
                                                   Text="{Binding Title, Converter={StaticResource LangKeyToValueConverter}}" />

                                    </StackPanel>

                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </suki:GlassCard>

            </Grid>

        </Border>

        <welcome:WelcomeView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                           IsVisible="{Binding IsWelcomeScreenVisible}" />

        <suki:SukiDialogHost Name="DialogHost" />
        <suki:SukiToastHost Position="TopLeft" Name="ToastHost"/>
    </Panel>

</UserControl>