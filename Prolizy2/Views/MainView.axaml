<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Prolizy2.ViewModels"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             
             xmlns:views="clr-namespace:Prolizy2.Views"
             xmlns:common="clr-namespace:Prolizy2.Views.Common"
             xmlns:welcome="clr-namespace:Prolizy2.Views.Welcome"
             mc:Ignorable="d"
             d:DesignWidth="450" d:DesignHeight="800"
             x:Class="Prolizy2.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel IsWelcomeScreenVisible="False" />
    </Design.DataContext>

    <UserControl.Styles>

        <Style Selector="StackPanel.IsTabItemSelected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SukiPrimaryColor}" />
        </Style>
        <Style Selector="StackPanel.IsTabItemSelected iconPacks|PackIconLucide">
            <Setter Property="Foreground" Value="{DynamicResource SukiPrimaryColor}" />
        </Style>

    </UserControl.Styles>

    <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Border Name="MainBorder" Background="Transparent" IsVisible="{Binding !IsWelcomeScreenVisible}">
            <Border.GestureRecognizers>
                <ScrollGestureRecognizer CanHorizontallyScroll="True" CanVerticallyScroll="False" />
            </Border.GestureRecognizers>

            <!--
            <Grid>

                <TabControl TabStripPlacement="Bottom" Margin="10"
                            Name="MainTabControl"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Classes="TabItemPanel">
                                <iconPacks:PackIconLucide Kind="File" />
                                <TextBlock Text="Home" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <suki:GlassCard Margin="0,0,0,25">
                                <suki:BusyArea Name="BusySignIn"
                                               BusyText="Connexion ..."
                                               IsBusy="{Binding IsLoggingIn}">
