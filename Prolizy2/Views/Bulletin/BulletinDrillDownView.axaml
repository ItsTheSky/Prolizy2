<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:bv="clr-namespace:Prolizy2.Views.Bulletin"
             xmlns:bvm="clr-namespace:Prolizy2.ViewModels.Bulletin"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="850"
             x:DataType="bvm:BulletinCoreViewModel"
             x:Class="Prolizy2.Views.Bulletin.BulletinDrillDownView">

    <!-- One TransitioningContentControl — the master and every detail are pages.
         When CurrentDetail is null the core VM is the page and templates to
         BulletinMasterView; otherwise the detail VM templates to its own view. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="bvm:BulletinCoreViewModel">
            <bv:BulletinMasterView />
        </DataTemplate>
        <DataTemplate DataType="bvm:UnitDetailViewModel">
            <bv:UnitDetailView />
        </DataTemplate>
        <DataTemplate DataType="bvm:EvaluationListViewModel">
            <bv:EvaluationListView />
        </DataTemplate>
        <DataTemplate DataType="bvm:EvaluationDetailViewModel">
            <bv:EvaluationDetailView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <TransitioningContentControl Background="Transparent"
                                 Content="{Binding CurrentPage}"
                                 PageTransition="{Binding DetailTransition}" />
</UserControl>
