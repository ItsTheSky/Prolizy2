<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:bm="clr-namespace:Prolizy2.Model.Bulletin"
             xmlns:bc="clr-namespace:Prolizy2.Styles.Controls.Bulletin"
             xmlns:badge="clr-namespace:Prolizy2.Styles.Controls"
             xmlns:bv="clr-namespace:Prolizy2.Views.Bulletin"
             xmlns:bvm="clr-namespace:Prolizy2.ViewModels.Bulletin"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="850"
             x:DataType="bvm:BulletinCoreViewModel"
             x:Class="Prolizy2.Views.Bulletin.BulletinAccordionView">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,40">

            <bv:BulletinHeaderSection />

            <bc:SectionHeader Icon="Layers"
                              Title="Unités d'enseignement"
                              Hint="{Binding SortedUnits.Count, StringFormat='{}{0} UE'}" />

            <ItemsControl ItemsSource="{Binding SortedUnits}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="bm:TeachingUnitInfo">
                        <bc:UnitCard Unit="{Binding}" DisplayMode="Accordion" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <bc:SectionHeader Icon="GraduationCap" Title="Compétences (RCUE)" />

            <ItemsControl ItemsSource="{Binding Data.Competences}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="bm:CompetenceInfo">
                        <suki:GlassCard Margin="3" Padding="10" CornerRadius="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <badge:Badge Grid.Column="1"
                                             Text="{Binding Status}"
                                             BadgeType="{Binding StatusBadgeType}" />
                            </Grid>
                        </suki:GlassCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander HorizontalAlignment="Stretch" Margin="0,16,0,0">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <LucideIcon Kind="BookOpen" Size="14"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="Ressources" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Data.Resources.Count, StringFormat='{}{0} éléments'}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SukiLowText}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Data.Resources}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bm:EvaluationGroupInfo">
                            <bc:EvaluationGroupCard Group="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <Expander HorizontalAlignment="Stretch" Margin="0,10,0,0">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <LucideIcon Kind="WandSparkles" Size="14"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="SAÉ" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Data.Saes.Count, StringFormat='{}{0} éléments'}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SukiLowText}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Data.Saes}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bm:EvaluationGroupInfo">
                            <bc:EvaluationGroupCard Group="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <TextBlock Text="{Binding Data.FinePrint}"
                       Margin="4,24,4,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SukiLowText}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
