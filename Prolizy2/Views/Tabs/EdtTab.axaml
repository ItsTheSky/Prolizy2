<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:edt="clr-namespace:Prolizy2.Styles.Controls.Edt"
             xmlns:tabs="clr-namespace:Prolizy2.ViewModels.Tabs"

             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:controls="clr-namespace:Prolizy2.Styles.Controls"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
             x:DataType="tabs:EdtViewModel"
             x:Class="Prolizy2.Views.Tabs.EdtTab">
    <Panel>
        <suki:BusyArea BusyText="{DynamicResource Loading}"
                       IsBusy="{Binding IsLoading}"
                       IsEnabled="{Binding IsConfigured}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"
                  ColumnDefinitions="*,Auto,*" ColumnSpacing="10">

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                            Spacing="10"
                            Orientation="Vertical"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding CurrentDayString, FallbackValue=...}" HorizontalAlignment="Center"
                               FontSize="24" FontWeight="SemiBold" />

                    <Button HorizontalAlignment="Stretch"
                            suki:ButtonExtensions.Icon="{iconPacks:Lucide Calendar}"
                            suki:ButtonExtensions.ShowProgress="{Binding IsLoading}"
                            Command="{Binding OpenCalendarCommand}">
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource EdtSelectDateTitle}" />
                    </Button>

                </StackPanel>

                <!-- Single column view (no secondary group) -->
                <TransitioningContentControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             Content="{Binding CurrentDailyControl}"
                                             PageTransition="{Binding DailyItemsTransition}"
                                             IsVisible="{Binding !HasSecondaryGroup}" />

                <!-- Two column view (with secondary group) -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                      ColumnDefinitions="*,10,*"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding HasSecondaryGroup}">

                    <!-- Labels -->
                    <suki:GlassCard Grid.Row="0" Grid.Column="0" Padding="10"
                                    Classes="Accent"
                                    CornerRadius="8" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PrimaryGroupName, FallbackValue='Groupe 1'}"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </suki:GlassCard>

                    <suki:GlassCard Grid.Row="0" Grid.Column="2" Padding="10"
                                    Classes="Accent"
                                    CornerRadius="8" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SecondaryGroupName, FallbackValue='Groupe 2'}"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </suki:GlassCard>

                    <!-- Schedule controls -->
                    <TransitioningContentControl Grid.Row="1" Grid.Column="0"
                                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                 Content="{Binding CurrentDailyControl}"
                                                 PageTransition="{Binding DailyItemsTransition}" />

                    <TransitioningContentControl Grid.Row="1" Grid.Column="2"
                                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                 Content="{Binding SecondaryDailyControl}"
                                                 PageTransition="{Binding DailyItemsTransition}" />
                </Grid>

                <Button Grid.Row="2" Grid.Column="0"
                        suki:ButtonExtensions.ShowProgress="{Binding IsLoading}"
                        suki:ButtonExtensions.Icon="{iconPacks:Lucide ChevronLeft}"
                        HorizontalAlignment="Stretch" Command="{Binding PreviousDayCommand}">
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource EdtPrevious}" />
                </Button>

                <Button Grid.Row="2" Grid.Column="1"
                        suki:ButtonExtensions.ShowProgress="{Binding IsLoading}"
                        Command="{Binding GoToTodayCommand}"
                        Padding="10">
                    <iconPacks:PackIconLucide Kind="House" VerticalAlignment="Center"
                                              Width="16" Height="16" />
                </Button>

                <Button Grid.Row="2" Grid.Column="2"
                        suki:ButtonExtensions.ShowProgress="{Binding IsLoading}"
                        HorizontalAlignment="Stretch" Command="{Binding NextDayCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource EdtNext}" />
                        <iconPacks:PackIconLucide Kind="ChevronRight" VerticalAlignment="Center"
                                                  Width="12" Height="12" />
                    </StackPanel>
                </Button>

            </Grid>
        </suki:BusyArea>

        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                ClipToBounds="True" CornerRadius="10"
                Background="#55000000"
                IsVisible="{Binding !IsConfigured}">
            <controls:PresentationBlock
                Icon="Settings"
                Title="{DynamicResource EdtNotConfiguredTitle}"
                Description="{DynamicResource EdtNotConfiguredDescription}"
                ButtonText="{DynamicResource EdtGoToSettings}"
                ButtonIcon="ArrowRight"
                ButtonCommand="{Binding OpenSettingsCommand}" />
        </Border>
    </Panel>
</UserControl>