<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:transitioningPageControl="clr-namespace:Prolizy2.Utilities.TransitioningPageControl"
             xmlns:bulletin="clr-namespace:Prolizy2.Views.Tabs.Bulletin"
             xmlns:tabs="clr-namespace:Prolizy2.ViewModels.Tabs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             
             x:DataType="tabs:BulletinCoreViewModel"
             x:Class="Prolizy2.Views.Tabs.BulletinTab">
    <transitioningPageControl:TransitioningPageControl>
        <bulletin:BulletinOverview />
        <bulletin:BulletinUnits />
    </transitioningPageControl:TransitioningPageControl>
</UserControl>
