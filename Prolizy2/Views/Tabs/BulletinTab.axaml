<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:bv="clr-namespace:Prolizy2.Views.Bulletin"
             xmlns:bvm="clr-namespace:Prolizy2.ViewModels.Bulletin"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="850"
             x:DataType="bvm:BulletinCoreViewModel"
             x:Class="Prolizy2.Views.Tabs.BulletinTab">
    <Panel>
        <bv:BulletinTabsView IsVisible="{Binding Options.IsTabsVariant}" />
        <bv:BulletinDrillDownView IsVisible="{Binding Options.IsDrillDownVariant}" />
    </Panel>
</UserControl>
