<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:home="clr-namespace:Prolizy2.Views.Home"
             xmlns:vmd="clr-namespace:Prolizy2.ViewModels.Tabs"
             xmlns:homeVm="clr-namespace:Prolizy2.ViewModels.Home"
             xmlns:shell="clr-namespace:Prolizy2.Styles.Controls.Home"
             mc:Ignorable="d"
             d:DesignWidth="450" d:DesignHeight="800"
             x:DataType="vmd:HomeViewModel"
             x:Class="Prolizy2.Views.Tabs.HomeTab">

    <Grid RowDefinitions="Auto,*" RowSpacing="10">

        <!-- Title bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8"
              Margin="0,4,0,0">

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Classes="Header"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,0"
                           Text="{DynamicResource HomeGreeting}" />
                <TextBlock Classes="Quote"
                           IsVisible="{Binding HasNoCards}"
                           Text="{DynamicResource HomeEmptyHint}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="Flat"
                    Padding="10"
                    VerticalAlignment="Center"
                    Command="{Binding EditLayoutCommand}"
                    ToolTip.Tip="{DynamicResource HomeSettingsEdit}">
                <LucideIcon Kind="Settings2" Size="20" />
            </Button>

        </Grid>

        <!-- Cards -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,20">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <home:HomeCardPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="homeVm:HomeCardViewModel">
                        <shell:HomeCardShell Title="{Binding Title}"
                                             Hint="{Binding Hint}"
                                             Icon="{Binding Icon}"
                                             AccentHex="{Binding AccentHex}"
                                             IsCompact="{Binding IsCompact}"
                                             Command="{Binding OpenCommand}"
                                             Content="{Binding Content}"
                                             ContentTemplate="{home:HomeCardTemplate}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>