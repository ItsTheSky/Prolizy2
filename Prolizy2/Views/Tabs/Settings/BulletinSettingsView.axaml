<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:Prolizy2.Styles.Controls.Settings"
             xmlns:vm="clr-namespace:Prolizy2.ViewModels.Tabs.Settings"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:badge="clr-namespace:Prolizy2.Styles.Controls"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="850"
             x:DataType="vm:BulletinSettingsViewModel"
             x:Class="Prolizy2.Views.Tabs.Settings.BulletinSettingsView">
    <settings:SettingSubPage Title="Bulletin"
                             BackCommand="{Binding BackCommand}">

        <ScrollViewer>
            <StackPanel Classes="MainSettingSection">

                <!-- Identifiants ScoDoc -->
                <suki:GlassCard Padding="25" Margin="-15,10,-15,0">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   FontSize="16" FontWeight="DemiBold"
                                   Text="{DynamicResource BulletinSettingsCredentialsTitle}" />

                        <badge:Badge Grid.Row="0" Grid.Column="1"
                                     Text="{Binding StatusMessage}"
                                     BadgeType="{Binding StatusBadge}"
                                     IsVisible="{Binding HasStatus}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Foreground="{DynamicResource SukiLowText}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource BulletinSettingsCredentialsDesc}" />

                        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                 Watermark="{DynamicResource BulletinSettingsUsernameWatermark}"
                                 IsEnabled="{Binding !IsBusy}"
                                 Text="{Binding Username}" />

                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                 Watermark="{DynamicResource BulletinSettingsPasswordWatermark}"
                                 PasswordChar="●"
                                 IsEnabled="{Binding !IsBusy}"
                                 Text="{Binding Password}" />

                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                Classes="Flat"
                                suki:ButtonExtensions.ShowProgress="{Binding IsBusy}"
                                Command="{Binding SaveCredentialsCommand}"
                                Content="{DynamicResource BulletinSettingsSaveButton}" />

                        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                Classes="Danger"
                                IsEnabled="{Binding IsConfigured}"
                                Command="{Binding DeleteCredentialsCommand}"
                                Content="{DynamicResource BulletinSettingsDeleteButton}" />
                    </Grid>
                </suki:GlassCard>

                <!-- Variante d'affichage -->
                <suki:GlassCard Padding="25" Margin="-15,10,-15,0">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10"
                          ColumnDefinitions="*,*" ColumnSpacing="10">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   FontSize="16" FontWeight="DemiBold"
                                   Text="{DynamicResource BulletinSettingsVariantTitle}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                   Foreground="{DynamicResource SukiLowText}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource BulletinSettingsVariantDesc}" />

                        <RadioButton Grid.Row="2" Grid.Column="0"
                                     Classes="GigaChips" HorizontalContentAlignment="Center"
                                     GroupName="BulletinVariant"
                                     IsChecked="{Binding Options.IsTabsVariant}">
                            <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                                       Text="{DynamicResource BulletinSettingsVariantTabs}" />
                        </RadioButton>
                        <RadioButton Grid.Row="2" Grid.Column="1"
                                     Classes="GigaChips" HorizontalContentAlignment="Center"
                                     GroupName="BulletinVariant"
                                     IsChecked="{Binding Options.IsDrillDownVariant}">
                            <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                                       Text="{DynamicResource BulletinSettingsVariantDrillDown}" />
                        </RadioButton>
                    </Grid>
                </suki:GlassCard>

                <!-- Densité -->
                <suki:GlassCard Padding="25" Margin="-15,10,-15,0">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10"
                          ColumnDefinitions="*,*" ColumnSpacing="10">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   FontSize="16" FontWeight="DemiBold"
                                   Text="{DynamicResource BulletinSettingsDensityTitle}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                   Foreground="{DynamicResource SukiLowText}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource BulletinSettingsDensityDesc}" />

                        <RadioButton Grid.Row="2" Grid.Column="0"
                                     Classes="GigaChips" HorizontalContentAlignment="Center"
                                     GroupName="BulletinDensity"
                                     IsChecked="{Binding Options.IsComfortable}">
                            <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                                       Text="{DynamicResource BulletinSettingsDensityComfort}" />
                        </RadioButton>
                        <RadioButton Grid.Row="2" Grid.Column="1"
                                     Classes="GigaChips" HorizontalContentAlignment="Center"
                                     GroupName="BulletinDensity"
                                     IsChecked="{Binding Options.IsCompact}">
                            <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                                       Text="{DynamicResource BulletinSettingsDensityCompact}" />
                        </RadioButton>
                    </Grid>
                </suki:GlassCard>

                <!-- Tri des UE -->
                <suki:GlassCard Padding="25" Margin="-15,10,-15,0">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10"
                          ColumnDefinitions="*,*" ColumnSpacing="10">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   FontSize="16" FontWeight="DemiBold"
                                   Text="{DynamicResource BulletinSettingsSortTitle}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                   Foreground="{DynamicResource SukiLowText}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource BulletinSettingsSortDesc}" />

                        <RadioButton Grid.Row="2" Grid.Column="0"
                                     Classes="GigaChips" HorizontalContentAlignment="Center"
                                     GroupName="BulletinSort"
                                     IsChecked="{Binding Options.IsSortByCode}">
                            <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                                       Text="{DynamicResource BulletinSettingsSortByCode}" />
                        </RadioButton>
                        <RadioButton Grid.Row="2" Grid.Column="1"
                                     Classes="GigaChips" HorizontalContentAlignment="Center"
                                     GroupName="BulletinSort"
                                     IsChecked="{Binding Options.IsSortByAverage}">
                            <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                                       Text="{DynamicResource BulletinSettingsSortByAverage}" />
                        </RadioButton>
                    </Grid>
                </suki:GlassCard>

                <!-- Couleur des UE -->
                <suki:GlassCard Padding="25" Margin="-15,10,-15,0">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10"
                          ColumnDefinitions="*,*" ColumnSpacing="10">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   FontSize="16" FontWeight="DemiBold"
                                   Text="{DynamicResource BulletinSettingsColorTitle}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                   Foreground="{DynamicResource SukiLowText}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource BulletinSettingsColorDesc}" />

                        <RadioButton Grid.Row="2" Grid.Column="0"
                                     Classes="GigaChips" HorizontalContentAlignment="Center"
                                     GroupName="BulletinColor"
                                     IsChecked="{Binding Options.IsColorByUnit}">
                            <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                                       Text="{DynamicResource BulletinSettingsColorByUnit}" />
                        </RadioButton>
                        <RadioButton Grid.Row="2" Grid.Column="1"
                                     Classes="GigaChips" HorizontalContentAlignment="Center"
                                     GroupName="BulletinColor"
                                     IsChecked="{Binding Options.IsColorByGrade}">
                            <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                                       Text="{DynamicResource BulletinSettingsColorByGrade}" />
                        </RadioButton>
                    </Grid>
                </suki:GlassCard>

                <!-- Détails affichés -->
                <suki:GlassCard Padding="25" Margin="-15,10,-15,0">
                    <StackPanel Spacing="14">
                        <TextBlock FontSize="16" FontWeight="DemiBold"
                                   Text="{DynamicResource BulletinSettingsDetailsTitle}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource BulletinSettingsShowRankLabel}" FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource BulletinSettingsShowRankDesc}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SukiLowText}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding Options.ShowRank}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource BulletinSettingsShowCoeffLabel}" FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource BulletinSettingsShowCoeffDesc}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SukiLowText}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding Options.ShowCoefficients}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource BulletinSettingsShowWeightChartLabel}" FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource BulletinSettingsShowWeightChartDesc}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SukiLowText}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding Options.ShowWeightBars}" />
                        </Grid>
                    </StackPanel>
                </suki:GlassCard>

            </StackPanel>
        </ScrollViewer>

    </settings:SettingSubPage>
</UserControl>
